{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "file-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "file-storage" }],
  "observability": { "enabled": true }
}

